# Test environment template. Copy this to .env.test and fill in real values.
# .env.test is gitignored. This template IS committed so teammates/CI know what's needed.

MONGODB_URI=mongodb+srv://USER:PASS@HOST/dorkari_test?retryWrites=true&w=majority

JWT_SECRET=copy-from-env-local
JWT_EXPIRY=3d

GOOGLE_CLIENT_ID=copy-from-env-local
GOOGLE_CLIENT_SECRET=copy-from-env-local
NEXTAUTH_SECRET=copy-from-env-local

NEXTAUTH_URL=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100

CLOUDINARY_CLOUD_NAME=copy-from-env-local
CLOUDINARY_API_KEY=copy-from-env-local
CLOUDINARY_API_SECRET=copy-from-env-local
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=copy-from-env-local
CLOUDINARY_FOLDER=dorkari-test
CLOUDINARY_SIGNATURE_TTL=600

TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=AdminPass123!
TEST_CUSTOMER_EMAIL=customer@test.local
TEST_CUSTOMER_PASSWORD=CustomerPass123!