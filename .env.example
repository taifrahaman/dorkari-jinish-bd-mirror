# Environment variables template
MONGODB_URI=mongo_URI_here
JWT_SECRET=random_secret_here
JWT_EXPIRY=3d


GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here
NEXTAUTH_SECRET=nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000



# Public URL used by the app (adjust for production later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ============================================================
# Cloudinary
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Public cloud name for building delivery URLs in the browser
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Optional: folder prefix in Cloudinary
CLOUDINARY_FOLDER=dorkari-jinish-bd

# ============================================================
# Admin upload signature (short-lived)
# ============================================================
# Signature expires in seconds (default 10 min)
CLOUDINARY_SIGNATURE_TTL=600